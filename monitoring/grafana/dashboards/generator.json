{
  "uid": "bench-generator",
  "title": "Generator (SERVER 1)",
  "description": "Open-loop OTLP load generator: rates, latency, in-flight, errors.",
  "tags": [
    "benchmark",
    "generator"
  ],
  "timezone": "utc",
  "editable": true,
  "schemaVersion": 39,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "label": "Datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "text": "Prometheus",
          "value": "Prometheus"
        },
        "hide": 0
      }
    ]
  },
  "panels": [

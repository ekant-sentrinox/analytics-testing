    {
      "type": "timeseries",
      "title": "In-flight and stalls",
      "description": "The open loop's one honest limit. When in-flight saturates, the pacer cannot submit on schedule and the deficit is recorded here rather than hidden by slowing down.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "bench_generator_inflight",
          "legendFormat": "in flight",
          "refId": "A",
          "editorMode": "code",
          "range": true

    {
      "type": "stat",
      "title": "Stalled",
      "description": "Milliseconds per second the pacer spent blocked on the inflight bound. Any sustained value means the offered rate was not actually offered.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "rate(bench_generator_stalled_ms_total[1m])",
          "legendFormat": "Stalled",
          "refId": "A",
          "editorMode": "code",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": null,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#6b7d8f",
                "value": null
              },
              {
                "color": "#c39b4e",
                "value": 100
              },
              {
                "color": "#b4553f",
                "value": 500
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",

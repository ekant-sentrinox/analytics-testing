# ---------------------------------------------------------------------------
# Generator (SERVER 1) — OTLP/gRPC open-loop load generator.
#
# ${VAR} is expanded from the process environment (see .env). Nothing secret
# belongs in this file.
# ---------------------------------------------------------------------------

generator:
  target:
    host: ${COLLECTOR_HOST}
    port: ${COLLECTOR_GRPC_PORT}
    # The collector speaks plaintext gRPC on 4317 in this deployment.
    tls: false
    # Per-RPC deadline. The export RPC does not ack until the batch is durable,
    # so this must be well above the worst expected flush, or a slow flush is
    # miscounted as a failure instead of as latency.
    rpc_timeout_seconds: 60

  auth:
    # HS512 JWT signed with the collector's shared secret.
    secret_b64: ${OTEL_JWT_SECRET_B64}
    # Routed by the x-dd-ingestion-queue claim. Must match an ingestion_queue
    # in the collector's ingestion_queue_table_mapping.
    ingestion_queue: ${OTEL_INGESTION_QUEUE}
    subject: bench-generator
    token_ttl_seconds: 3600

  # -------------------------------------------------------------------------
  # A model of the collector, used ONLY to check whether a target rate is
  # physically reachable before the run starts. Mirror of config/collector.yaml
  # — change both together.
  #
  # WHY THIS EXISTS. The export RPC does not ack until the batch is durable, so
  # a worker is blocked for a whole flush. A bucket flushes when it reaches
  # min_bucket_size OR after max_delay_ms, whichever comes first — and at low
  # rates the timer always wins. That gives a hard ceiling:
  #
  #     max_rps = workers x batch_size / flush_seconds
  #
  # Measured on this deployment: 4 workers x 200 records with a 5 s flush
  # predicted 160 rec/s, and a run targeting 1000 rec/s delivered 161 rec/s
  # with p50 latency of 4998 ms — the flush timer, exactly. The generator now
  # refuses to pretend, and warns at startup instead.
  # -------------------------------------------------------------------------
  pipeline:
    max_delay_ms: 5000
    min_bucket_size: 67108864      # FINAL mirror
    # body_bytes plus attributes, trace/span ids and OTLP framing.
    approx_record_bytes: 500

  workload:
    # Offered rate in records/sec. This is what the generator ATTEMPTS.
    # It is not throughput — see RESULTS.md.
    target_rps: 1000
    duration_seconds: 60
    ramp_up_seconds: 0
    ramp_down_seconds: 0
    # Worker tasks submitting RPCs concurrently.
    workers: 8
    # gRPC channels; workers are spread over them round-robin.
    channels: 4
    # Records per export RPC.
    batch_size: 500
    # Hard cap on concurrently outstanding RPCs. When this is hit the generator
    # cannot keep pace and the stall is counted (generator_stalled_ms), never
    # hidden by slowing the clock.
    max_inflight: 64
    # R7: never silently retry a RESOURCE_EXHAUSTED. Count it.
    # "polite" honours the server's RetryInfo delay; used only where the test
    # definition says so. Recorded in the manifest either way.
    retry_mode: none          # none | polite
    # Stop early if the pipeline is clearly gone.
    abort_on_consecutive_failures: 0    # 0 disables

  data:
    tenant_id: testing-tenant
    workspace_id: testing-workspace
    service_names: [checkout, payments, search, inventory, recommendations]
    environments: [prod, staging]
    regions: [us-west-2]
    # Deterministic payloads: same seed -> byte-identical record stream.
    seed: 42
    # Approximate serialized body size per record, bytes.
    body_bytes: 256
    severity_mix:
      INFO: 0.80
      WARN: 0.12
      ERROR: 0.07
      FATAL: 0.01
    # Model/analytics attributes. Emitted only when enabled.
    model_traffic:
      enabled: true
      models: [claude-opus-5, claude-sonnet-5, claude-haiku-4-5]
      input_tokens:  { min: 100,  max: 8000 }
      output_tokens: { min: 20,   max: 2000 }
      # USD per 1M tokens; used to derive request/response/total cost.
      pricing:
        claude-opus-5:    { input: 5.00, output: 25.00 }
        claude-sonnet-5:  { input: 3.00, output: 15.00 }
        claude-haiku-4-5: { input: 1.00, output: 5.00 }
    http_status_mix:
      200: 0.94
      400: 0.02
      429: 0.01
      500: 0.02
      503: 0.01
    latency_ms:
      p50: 120
      p95: 800
      p99: 2500
      max: 15000

  output:
    # Per-second samples and the final manifest land here.
    results_dir: ${RESULTS_DIR}
    sample_interval_seconds: 1
    # Prometheus scrape endpoint exposed by the generator process.
    metrics_port: ${GENERATOR_METRICS_PORT}

# ---------------------------------------------------------------------------
# Named workload profiles. `run-test.sh <profile>` overlays the named block on
# generator.workload above. Every value here is meant to be edited.
#
# step lists drive staircase execution: each (rps, duration_seconds) runs back
# to back and every sample is tagged with its step index.
# ---------------------------------------------------------------------------
profiles:

  smoke:
    description: Prove the pipeline end to end. Not a performance measurement.
    # 10 rec/s x 5 s flush = 50 records in flight; 2 x 50 = 100. Ample.
    workload: { target_rps: 10, duration_seconds: 60, workers: 2, channels: 1, batch_size: 50 }

  light:
    description: Low steady load; useful as a background while faults are injected.
    # 1000 x 5 s = 5,000 records must be in flight. 10 x 500 = 5,000.
    workload: { target_rps: 1000, duration_seconds: 300, workers: 10, channels: 2,
                batch_size: 500, max_inflight: 32 }

  medium:
    # 5,000 x 5 s = 25,000 in flight. 25 x 1000 = 25,000.
    workload: { target_rps: 5000, duration_seconds: 600, workers: 25, channels: 4,
                batch_size: 1000, max_inflight: 64 }

  high:
    # 10,000 x 5 s = 50,000 in flight. 25 x 2000 = 50,000. Above ~33k rec/s the
    # 16 MiB size trigger fires before the timer and the requirement eases.
    workload: { target_rps: 10000, duration_seconds: 1800, workers: 25, channels: 4,
                batch_size: 2000, max_inflight: 64 }

  throughput:
    description: >
      Staircase to find the maximum SUSTAINABLE rate. A level counts only if
      accepted >= 0.99 * offered, uncompacted-file backlog is not trending up
      over the second half, and there are no rejections, restarts or OOMs.
      step_duration must contain several compaction cycles or the backlog slope
      is noise — see TEST_PLAN.md.
    steps:
      - { rps: 1000,  duration_seconds: 600 }
      - { rps: 2000,  duration_seconds: 600 }
      - { rps: 5000,  duration_seconds: 600 }
      - { rps: 10000, duration_seconds: 600 }
      - { rps: 15000, duration_seconds: 600 }
      - { rps: 20000, duration_seconds: 600 }
      - { rps: 25000, duration_seconds: 600 }
    # Sized for the top rung: 25,000 x 5 s = 125,000 in flight -> 50 x 2500.
    workload: { workers: 50, channels: 8, batch_size: 2500, max_inflight: 128 }

  stress:
    description: Push past the knee until throughput plateaus or errors climb, then stop.
    steps:
      - { rps: 10000, duration_seconds: 180 }
      - { rps: 20000, duration_seconds: 180 }
      - { rps: 30000, duration_seconds: 180 }
      - { rps: 40000, duration_seconds: 180 }
      - { rps: 50000, duration_seconds: 180 }
    workload: { workers: 80, channels: 8, batch_size: 4000, max_inflight: 320 }
    stop_when:
      # Evaluated per step, on the steady-state window only.
      accepted_ratio_below: 0.90
      error_rate_above: 0.05
      latency_p99_ms_above: 60000

  soak:
    description: Long run at a fraction of the measured sustainable rate. Watch for drift.
    # 3,000 x 5 s = 15,000 in flight. 20 x 750 = 15,000.
    workload: { target_rps: 3000, duration_seconds: 21600, workers: 20, channels: 4,
                batch_size: 750, max_inflight: 48 }
    checkpoint_interval_seconds: 3600

  recovery:
    description: >
      Steady load while a component is restarted. The generator keeps running
      through the fault so loss, duplication and recovery time are measurable.
    # 2,000 x 5 s = 10,000 in flight. 20 x 500 = 10,000.
    workload: { target_rps: 2000, duration_seconds: 900, workers: 20, channels: 4,
                batch_size: 500, max_inflight: 48 }
    fault:
      # Which component to disturb, and how. Executed by tests/failure/.
      target: collector        # collector | compactor | none
      action: sigterm          # sigterm | sigkill | none
      at_seconds: 300
      restart_after_seconds: 30

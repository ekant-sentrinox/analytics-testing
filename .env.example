# ---------------------------------------------------------------------------
# analytics-distributed-test — environment
#
# Copy to .env and edit.  .env is gitignored and MUST NOT be committed.
# No secret values belong in this file: passwords are read from files on disk
# (PG_PASSWORD_FILE) and AWS credentials come from the EC2 instance role.
# ---------------------------------------------------------------------------

# --- Servers -----------------------------------------------------------------
GENERATOR_HOST=10.16.21.20
COLLECTOR_HOST=10.16.24.204
COMPACTOR_HOST=10.16.25.10

SSH_USER=ec2-user
SSH_KEY=~/.ssh/id_ed25519

# --- Ports (discovered from dazzleduck-sql-server reference.conf) -------------
# otel-collector: grpc_port = 4317, health.port = 8081
# ducklake-compactor: health_port = 8080
COLLECTOR_GRPC_PORT=4317
COLLECTOR_HEALTH_PORT=8081
COMPACTOR_HEALTH_PORT=8080

# Generator's own Prometheus endpoint (this project, runs on SERVER 1)
GENERATOR_METRICS_PORT=9102
# Pipeline exporter (this project, runs on SERVER 1, scrapes S2+S3+PG+S3-bucket)
PIPELINE_EXPORTER_PORT=9101
# node_exporter, if deployed on each server
NODE_EXPORTER_PORT=9100

# --- PostgreSQL RDS (DuckLake catalog) ---------------------------------------
PG_HOST=analytics-perf-catalog.ctu62c8oii9y.us-west-2.rds.amazonaws.com
PG_PORT=5432
PG_DATABASE=bench_catalog
PG_USER=analytics
# Path to a file containing ONLY the password. Never put the password here.
PG_PASSWORD_FILE=/home/ec2-user/.config/sentrinox/analytics-perf-catalog.pw

# --- S3 (DuckLake data) -------------------------------------------------------
# Authentication is via the EC2 instance role (analytics-performance-s3-role).
# Do NOT set AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY here.
AWS_REGION=us-west-2
S3_BUCKET=sentri-analytics-performance-test
# All writes by this project stay under this prefix. Cleanup is restricted to it.
S3_PREFIX=bench

# --- DuckLake -----------------------------------------------------------------
DUCKLAKE_CATALOG=bench
DUCKLAKE_SCHEMA=main
DUCKLAKE_LOGS_TABLE=logs
DUCKLAKE_WATERMARK_TABLE=ingest_watermark

# --- Collector auth -----------------------------------------------------------
# Base64 HMAC key shared by the collector and the generator's JWT signer.
# Generate with: scripts/gen-secret.sh   (writes into .env, 64 random bytes)
OTEL_JWT_SECRET_B64=
# JWT claim x-dd-ingestion-queue -> must match a configured ingestion_queue
OTEL_INGESTION_QUEUE=logs

# --- Test run defaults --------------------------------------------------------
DEFAULT_PROFILE=smoke
RESULTS_DIR=results
LOGS_DIR=logs

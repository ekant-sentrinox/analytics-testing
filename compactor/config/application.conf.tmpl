# ---------------------------------------------------------------------------
# dazzleduck-sql-ducklake-compactor — SERVER 3 (@COMPACTOR_HOST@)
#
# NOTE ON LOADING: the compactor does NOT take a -c/--config file. Its
# CompactionConfig.rawConfig() calls ConfigFactory.load("application"), i.e. it
# reads application.conf from the CLASSPATH. The run script therefore puts this
# file's directory FIRST on the classpath so it shadows the copy baked into the
# module. Only --conf key=value overrides are accepted on the command line.
#
# Rendered by scripts/deploy-compactor.sh. ${PG_PASSWORD} is resolved from the
# environment at process start, so the password is not written to disk here.
# ---------------------------------------------------------------------------

dazzleduck_sql_compaction {

    # Catalog names, as ATTACHed by the startup script below.
    databases = ["@DUCKLAKE_CATALOG@"]

    minor_compaction_frequency = @MINOR_COMPACTION_FREQUENCY@
    major_compaction_frequency = @MAJOR_COMPACTION_FREQUENCY@

    minor_compaction_max_size  = @MINOR_COMPACTION_MAX_SIZE@
    major_compaction_max_size  = @MAJOR_COMPACTION_MAX_SIZE@

    housekeeping_frequency     = @HOUSEKEEPING_FREQUENCY@
    snapshot_retention         = @SNAPSHOT_RETENTION@

    health_port = @COMPACTOR_HEALTH_PORT@

    # Same ATTACH as the collector, minus the arrow extension (the compactor
    # never sees Arrow IPC). Both processes are writers against one catalog.
    startup_script_provider {
        content = "INSTALL httpfs; LOAD httpfs; INSTALL aws; LOAD aws; INSTALL ducklake; LOAD ducklake; INSTALL postgres; LOAD postgres; SET threads = @DUCKDB_THREADS@; SET memory_limit = '@DUCKDB_MEMORY_LIMIT@'; SET temp_directory = '@DUCKDB_TEMP_DIR@'; CREATE OR REPLACE SECRET s3_role (TYPE S3, PROVIDER credential_chain, REFRESH auto, REGION '@AWS_REGION@'); ATTACH 'ducklake:postgres:host=@PG_HOST@ port=@PG_PORT@ dbname=@PG_DATABASE@ user=@PG_USER@ password="${PG_PASSWORD}"' AS @DUCKLAKE_CATALOG@ (DATA_PATH 's3://@S3_BUCKET@/@S3_PREFIX@/', DATA_INLINING_ROW_LIMIT 0);"
    }
}

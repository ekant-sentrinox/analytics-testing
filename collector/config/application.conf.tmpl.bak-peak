# ---------------------------------------------------------------------------
# dazzleduck-sql-otel-collector — SERVER 2 (@COLLECTOR_HOST@)
#
# Rendered by scripts/deploy-collector.sh from this template. Placeholders come
# from .env and config/collector.yaml; the catalog password is NOT rendered —
# it is resolved at process start
# from the PG_PASSWORD environment variable (HOCON substitution), so no copy of
# the secret is written next to this file.
#
# Data  -> s3://@S3_BUCKET@/@S3_PREFIX@/
# Catalog -> postgres @PG_HOST@/@PG_DATABASE@
# ---------------------------------------------------------------------------

otel_collector {

    grpc_port = @COLLECTOR_GRPC_PORT@

    health {
        port = @COLLECTOR_HEALTH_PORT@
        shutdown_grace_period_ms = 2000
    }

    # -----------------------------------------------------------------------
    # Startup SQL. Runs once on the singleton DuckDB connection before any
    # queue exists, so the catalog is attached before the first batch lands.
    #
    # HOCON value concatenation is used to splice ${PG_PASSWORD} in from the
    # environment. That forces this to be one long quoted string: triple-quoted
    # HOCON strings do not perform substitution.
    #
    # DATA_INLINING_ROW_LIMIT 0 is required. DuckLake otherwise keeps small
    # commits as inlined rows in the catalog instead of Parquet files on S3,
    # which would leave the compactor with nothing to merge and make the
    # benchmark measure the wrong thing.
    # -----------------------------------------------------------------------
    startup_script_provider {
        content = "INSTALL arrow FROM community; LOAD arrow; INSTALL httpfs; LOAD httpfs; INSTALL aws; LOAD aws; INSTALL ducklake; LOAD ducklake; INSTALL postgres; LOAD postgres; SET threads = @DUCKDB_THREADS@; SET memory_limit = '@DUCKDB_MEMORY_LIMIT@'; SET temp_directory = '@DUCKDB_TEMP_DIR@'; CREATE OR REPLACE SECRET s3_role (TYPE S3, PROVIDER credential_chain, REGION '@AWS_REGION@'); ATTACH 'ducklake:postgres:host=@PG_HOST@ port=@PG_PORT@ dbname=@PG_DATABASE@ user=@PG_USER@ password="${PG_PASSWORD}"' AS @DUCKLAKE_CATALOG@ (DATA_PATH 's3://@S3_BUCKET@/@S3_PREFIX@/', DATA_INLINING_ROW_LIMIT 0);"
    }

    # -----------------------------------------------------------------------
    # Queue tuning. These are the knobs that decide Parquet file size, and file
    # size decides how much work the compactor has to do. Held constant across
    # a staircase; see config/collector.yaml for the values under test.
    # -----------------------------------------------------------------------
    ingestion {
        min_bucket_size               = @MIN_BUCKET_SIZE@
        max_delay_ms                  = @MAX_DELAY_MS@
        queue_config_refresh_delay_ms = 120000
    }

    ingestion_task_factory_provider {
        class = "io.dazzleduck.sql.commons.ingestion.DuckLakeIngestionTaskFactoryProvider"

        ingestion_queue_table_mapping = [
            {
                ingestion_queue = "logs"
                catalog = "@DUCKLAKE_CATALOG@"
                schema  = "@DUCKLAKE_SCHEMA@"
                table   = "@DUCKLAKE_LOGS_TABLE@"

                # One watermark row per flushed bucket, committed in the same
                # transaction as the file registration. Gives (a) end-to-end
                # visibility lag and (b) a transactional per-batch row count to
                # reconcile the generator manifest against.
                additional_parameters {
                    watermark_table                = "@DUCKLAKE_WATERMARK_TABLE@"
                    watermark_timestamp_column     = "timestamp"
                    watermark_min_timestamp_column = "min_timestamp"
                    watermark_max_timestamp_column = "max_timestamp"
                    watermark_row_count_column     = "row_count"
                    watermark_snapshot_id_column   = "min_commit_snapshot_id"
                }
            }
        ]
    }

    authentication = "jwt"
    secret_key     = "@OTEL_JWT_SECRET_B64@"
    jwt_token { verify_signature = true }

    users = [
        { username = bench, password = @COLLECTOR_BASIC_PASSWORD@ }
    ]

    service_name = "bench-collector"
}
